# Скопируйте этот файл в .env и при необходимости поменяйте порт:
#   Windows:  copy .env.example .env
#   macOS:    cp .env.example .env
# Порт используется и приложением, и docker-compose.yml
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lego_classifier
DB_USER=postgres
DB_PASSWORD=postgres

# development — локально; на сервере docker-compose.prod.yml сам ставит production
ENV=development
# 1 — печатать SQL-запросы в консоль, 0 — не печатать
SQL_ECHO=1

# ---- Только для сервера (docker-compose.prod.yml) ----
# Домен сайта, например lego.example.ru (Caddy получит HTTPS сам). :80 — доступ по http://IP-сервера без HTTPS
SITE_ADDRESS=:80
# Логин и хэш пароля для входа на сайт. Хэш:  docker run --rm caddy:2 caddy hash-password --plaintext 'ваш_пароль'
# Хэш записывать в одинарных кавычках: AUTH_HASH='$2a$14$...'
AUTH_USER=lego
AUTH_HASH=
